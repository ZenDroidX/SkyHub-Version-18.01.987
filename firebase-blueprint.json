{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the Skyhub platform.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile picture URL."
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "developer", "user"],
          "description": "The user's role in the system."
        },
        "permissions": {
          "type": "object",
          "description": "Specific rights granted to the user.",
          "properties": {
            "canPromoteToAdmin": { "type": "boolean" },
            "canPromoteToDeveloper": { "type": "boolean" },
            "canManageUsers": { "type": "boolean" }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was last updated."
        }
      },
      "required": ["uid", "email", "role"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global configuration for the Skyhub platform.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "welcomeMessage": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/settings/global": {
      "schema": "SiteSettings",
      "description": "Global site configuration."
    }
  }
}
